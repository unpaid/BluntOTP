<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>
		  netstandard2.0;
		  netstandard2.1;
		  netcoreapp3.0;
		  netcoreapp3.1;
		  net5.0;
		  net6.0;
		  net7.0;
		  net8.0;
		  net9.0;
	  </TargetFrameworks>
	  <ImplicitUsings>false</ImplicitUsings>
	  <Nullable Condition="$(TargetFramework.StartsWith('net8')) or $(TargetFramework.StartsWith('net9'))">enable</Nullable>
  </PropertyGroup>

</Project>
